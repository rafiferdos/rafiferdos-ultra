# Public site URL, without a trailing slash
NEXT_PUBLIC_SITE_URL=https://rafiferdos.com

# PostgreSQL. Use pooled runtime + direct CLI URLs when your provider offers both.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:6543/DATABASE?pgbouncer=true
DIRECT_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE

# First-login bootstrap. The first valid login creates a bcrypt-hashed Admin row.
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password
ADMIN_SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_NAME=Rafi Ferdos

# Cloudinary is used only for dashboard image uploads.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Optional contact automation fallback.
CONTACT_WEBHOOK_URL=

# Optional search-engine ownership verification tokens.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
